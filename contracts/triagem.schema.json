    },
    "ajuste_llm": {
      "default": 0,
      "maximum": 20,
      "minimum": -20,
      "title": "Ajuste Llm",
      "type": "integer"
    },
    "motivo_llm": {
      "default": "",
      "title": "Motivo Llm",
      "type": "string"
    },
    "versao_regras": {
      "title": "Versao Regras",
      "type": "string"
    }
  },
  "required": [
    "item_id",
    "nota",
    "faixa",
    "motivos",
    "acao_sugerida",
    "versao_regras"
