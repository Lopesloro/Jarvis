      "enum": [
        "responder",
        "agendar",
        "ler",
        "arquivar"
      ],
      "title": "Acao",
      "type": "string"
    },
    "Faixa": {
      "enum": [
        "agora",
        "hoje",
        "semana",
        "arquivar"
      ],
      "title": "Faixa",
      "type": "string"
    },
    "Motivo": {
      "properties": {
        "sinal": {
          "title": "Sinal",
          "type": "string"
        },
        "pontos": {
          "title": "Pontos",
          "type": "integer"
        },
        "explicacao": {
          "title": "Explicacao",
          "type": "string"
        }
      },
      "required": [
        "sinal",
        "pontos",
        "explicacao"
      ],
      "title": "Motivo",
      "type": "object"
    }
  },
  "properties": {
    "item_id": {
      "title": "Item Id",
      "type": "string"
    },
    "nota": {
      "maximum": 100,
      "minimum": 0,
      "title": "Nota",
      "type": "integer"
    },
    "faixa": {
      "$ref": "#/$defs/Faixa"
    },
    "motivos": {
