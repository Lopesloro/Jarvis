#!/usr/bin/env bash
# Nada sobe para o GitHub sem revisão do /harvey cobrindo todos os commits.
cd "$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
while read -r _local_ref local_sha _remoto_ref remoto_sha; do
  [ "$local_sha" = "$zero" ] && continue          # apagando branch
  base=""; [ "$remoto_sha" != "$zero" ] && base="$remoto_sha"
  scripts/revisao.sh checar "$base" "$local_sha" || exit 1
done
