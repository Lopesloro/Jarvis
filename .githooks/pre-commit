#!/usr/bin/env bash
# Bloqueia o commit se qualquer checagem falhar. Pular só em emergência: git commit --no-verify
# (o CI roda tudo de novo e o pre-push ainda exige a revisão do /harvey).
cd "$(git rev-parse --show-toplevel)"
if git diff --cached --name-only | grep -q '^bridge/'; then exec scripts/checar.sh; fi
exec scripts/checar.sh rapido
